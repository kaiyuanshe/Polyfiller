# Polyfiller 环境配置示例
# 复制此文件为 .env 并根据需要修改配置

# 基础服务配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# S3 存储配置
# 填写您的 S3 兼容存储配置以启用云存储
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=polyfiller-storage
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# 本地缓存配置
LOCAL_CACHE_DIR=/tmp/@wessberg/polyfiller
MAX_CACHE_SIZE=500

# 文件系统 Hook 配置
# 设置为 true 启用文件系统 hook（需要 S3 配置）
ENABLE_FS_HOOK=false

# 可选：自定义 fs hook 挂载路径（默认使用 LOCAL_CACHE_DIR）
# FS_HOOK_MOUNT_PATH=/custom/mount/path

# 是否启用 fs hook 调试日志
FS_HOOK_DEBUG=false

# fs hook 同步操作超时时间（毫秒）
FS_HOOK_SYNC_TIMEOUT=5000

# fs hook 缓存条目数量
FS_HOOK_CACHE_SIZE=100

# SSL 配置（可选）
HTTPS=false
# KEY=path/to/private-key.pem
# CERT=path/to/certificate.pem

# 监控配置（可选）
# SENTRY_DSN=your-sentry-dsn

# 测试配置
TESTING=false
CLEAR_CACHE=false 